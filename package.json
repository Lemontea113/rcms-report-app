{
  "name": "rcms-report-app",
  "productName": "RCMS Report App",
  "version": "1.0.0",
  "description": "RCMS 과제번호 목록으로 사용실적보고서를 자동 조회합니다.",
  "author": "Lemontea113",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "build:web": "next build && node scripts/prepare-standalone.js",
    "app": "npm run build:web && electron .",
    "dist": "npm run build:web && electron-builder --win",
    "release": "npm run build:web && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "next": "16.3.5",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.lemontea113.rcms-report-app",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.js",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "RCMS-Report-App-Setup-${version}.${ext}",
      "shortcutName": "RCMS 사용실적보고서 조회",
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "Lemontea113",
      "repo": "rcms-report-app",
      "releaseType": "release"
    }
  }
}
